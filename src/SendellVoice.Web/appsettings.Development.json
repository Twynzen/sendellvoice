{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=SendellVoice;User Id=sa;Password=${SQL_SA_PASSWORD};TrustServerCertificate=True"
  },
  "Security": {
    "ApiKey": "",
    "RequireApiKey": false
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000", "http://localhost:5173", "http://localhost:8080"]
  },
  "Providers": {
    "LLM": "Ollama",
    "Speech": "WhisperNet",
    "VectorStore": "InMemory"
  },
  "Ollama": {
    "Endpoint": "http://localhost:11434",
    "Model": "llama3.2",
    "EmbeddingModel": "nomic-embed-text"
  },
  "WhisperNet": {
    "ModelPath": "./models/ggml-base.bin",
    "Language": "auto"
  },
  "FileUpload": {
    "MaxFileSizeBytes": 104857600,
    "AllowedExtensions": [".pdf", ".docx", ".txt", ".md", ".html", ".htm"]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  }
}
