{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Security": {
    "ApiKey": "",
    "RequireApiKey": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Providers": {
    "LLM": "Ollama",
    "Speech": "WhisperNet",
    "VectorStore": "InMemory"
  },
  "AzureOpenAI": {
    "Endpoint": "",
    "ApiKey": "",
    "ChatDeployment": "gpt-4o-mini",
    "EmbeddingDeployment": "text-embedding-3-small"
  },
  "Ollama": {
    "Endpoint": "http://localhost:11434",
    "Model": "llama3.2",
    "EmbeddingModel": "nomic-embed-text"
  },
  "AzureSpeech": {
    "SubscriptionKey": "",
    "Region": "eastus",
    "Language": "en-US"
  },
  "WhisperNet": {
    "ModelPath": "./models/ggml-base.bin",
    "Language": "auto"
  },
  "AzureAISearch": {
    "Endpoint": "",
    "ApiKey": "",
    "IndexName": "sendellvoice-docs"
  },
  "Qdrant": {
    "Host": "localhost",
    "Port": 6334
  },
  "FileUpload": {
    "MaxFileSizeBytes": 52428800,
    "AllowedExtensions": [".pdf", ".docx", ".txt", ".md", ".html"]
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
